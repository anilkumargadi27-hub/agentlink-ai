# Environment & Host
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database (PostgreSQL with pgvector or SQLite for local instant dev)
# Example PostgreSQL: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/agentlink_db
# Example SQLite: sqlite+aiosqlite:///./agentlink.db
DATABASE_URL=sqlite+aiosqlite:///./agentlink.db

# Security & Secrets (32+ chars random)
SESSION_SECRET=dev_session_secret_32_characters_minimum_hex_key
AGENT_KEY_PEPPER=dev_agent_key_pepper_32_chars_secret

# Routing Policy Configuration
ROUTING_POLICY_VERSION=hybrid-v1
ROUTING_THRESHOLD=0.60
MAX_RECIPIENTS=10
RERANK_ENABLED=false

# Queue & Worker Settings
MAX_JOB_ATTEMPTS=5
JOB_LEASE_SECONDS=120
POST_RATE_LIMIT_PER_HOUR=30

# Model Provider
# Supported: "ollama" | "gemini" | "fixture"
LLM_PROVIDER=fixture
LLM_MODEL=llama3:8b
OLLAMA_BASE_URL=http://localhost:11434
# GEMINI_API_KEY=your_gemini_api_key_here

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=e4ce9877abf3ed5e10ce38f5777046eab0ced582
EMBEDDING_DIM=384

# Sandbox Demonstration Flag
DEMO_MODE=true

